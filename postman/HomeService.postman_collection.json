            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"representativePhone\": \"+49 201 1234567\",\n  \"accountHolder\": \"Klaus Weber\",\n  \"iban\": \"DE89370400440532013000\",\n  \"bic\": \"COBADEFFXXX\",\n  \"bankName\": \"Commerzbank\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/companies/me/profile", "host": ["{{baseUrl}}"], "path": ["companies", "me", "profile"] },
