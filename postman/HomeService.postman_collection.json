{
  "info": {
    "_postman_id": "b3f1a6d2-4c2e-4a3b-9f7d-homeservice0001",
    "name": "HomeService API",
    "description": "Shared REST API for home-services-app (clients) and home-services-company-app (companies/workers/independents). See docs/API.md for the prose reference this collection mirrors, and docs/POSTMAN.md for how to use it.\n\nAuth: the collection-level auth is Bearer {{accessToken}}. Run \"Auth > Login\" first (against a seeded account, e.g. anna.schmidt@example.com / Passw0rd!) — its test script writes {{accessToken}} into this collection's variables automatically, so every subsequent request just works. A handful of other requests (Create Booking, Add Worker, List Companies, ...) similarly capture IDs they return into variables like {{bookingId}} so requests further down a folder can chain off them without manual copy-pasting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" },
    { "key": "companyId", "value": "", "type": "string" },
    { "key": "independentId", "value": "", "type": "string" },
    { "key": "workerId", "value": "", "type": "string" },
    { "key": "reviewId", "value": "", "type": "string" },
    { "key": "conversationId", "value": "", "type": "string" },
    { "key": "paymentMethodId", "value": "", "type": "string" },
    { "key": "notificationId", "value": "", "type": "string" },
    { "key": "photoId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "http://localhost:4000/health", "protocol": "http", "host": ["localhost"], "port": "4000", "path": ["health"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register — Client",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"role\": \"client\",\n  \"email\": \"test.client@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Client\",\n  \"phone\": \"+49 201 5551111\",\n  \"locale\": \"de\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "response": []
        },
        {
          "name": "Register — Company Manager",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"role\": \"company_manager\",\n  \"email\": \"new.manager@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"firstName\": \"Erika\",\n  \"lastName\": \"Musterfrau\",\n  \"phone\": \"+49 201 5552222\",\n  \"company\": {\n    \"legalName\": \"Musterfirma Sanitär GmbH\",\n    \"legalFormCode\": \"gmbh\",\n    \"street\": \"Musterstraße 1\",\n    \"postalCode\": \"45131\",\n    \"city\": \"Essen\",\n    \"representativeName\": \"Erika Musterfrau\",\n    \"representativeEmail\": \"erika@musterfirma-sanitaer.de\",\n    \"representativePhone\": \"+49 201 5552222\",\n    \"taxNumber\": \"5123/9999/0001\",\n    \"vatId\": \"DE999999999\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "response": []
        },
        {
          "name": "Register — Independent Provider",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"role\": \"independent_provider\",\n  \"email\": \"new.independent@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"firstName\": \"Lena\",\n  \"lastName\": \"Fischer\",\n  \"phone\": \"+49 201 5553333\",\n  \"independent\": {\n    \"businessName\": \"Lena Fischer\",\n    \"legalFormCode\": \"einzelunternehmen\",\n    \"street\": \"Beispielweg 5\",\n    \"postalCode\": \"45147\",\n    \"city\": \"Essen\",\n    \"taxNumber\": \"5124/8888/0002\",\n    \"primaryCategoryCode\": \"elektriker\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  console.log('accessToken saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"anna.schmidt@example.com\",\n  \"password\": \"Passw0rd!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Any seeded account works — password is always \"Passw0rd!\" (see db/seed.sql). Try klaus.weber@ruettenscheider-sanitaer.de for a company manager, sercan.yildiz@ruettenscheider-sanitaer.de for a worker, or max@musterfirma.de for an independent."
          },
          "response": []
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"refreshToken\": \"\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "In a browser/app, the refresh token travels as an httpOnly cookie set by Login/Register, so this body is normally sent empty. Postman does store cookies per-domain automatically (see the Cookies drawer) — the body field only matters for non-cookie clients."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "response": []
        }
      ]
    },
