    {
      "name": "Bookings",
      "item": [
        {
          "name": "List my bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings?status=upcoming&unassignedOnly=false&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"],
              "query": [
                { "key": "status", "value": "upcoming", "description": "pending | upcoming | in_progress | completed | cancelled" },
                { "key": "unassignedOnly", "value": "false", "description": "company_manager only" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Scope depends on who's logged in: a client sees their own bookings, a manager their company's, a worker their assignments, an independent their own."
          },
          "response": []
        },
        {
          "name": "Create booking — as client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.booking?.id) pm.collectionVariables.set('bookingId', json.data.booking.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"categoryCode\": \"klempner\",\n  \"serviceLabel\": \"Wasserhahn tropft\",\n  \"providerType\": \"company\",\n  \"companyId\": \"{{companyId}}\",\n  \"addressStreet\": \"Rüttenscheider Straße 142\",\n  \"addressPostalCode\": \"45131\",\n  \"addressCity\": \"Essen\",\n  \"scheduledDate\": \"2026-09-10\",\n  \"scheduledTime\": \"14:00\",\n  \"priceGross\": 65.00,\n  \"isEmergency\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] },
            "description": "Log in as a client first (e.g. anna.schmidt@example.com), and run Companies > List public companies first so {{companyId}} is populated. priceGross is the only money figure you send — the server computes the platform fee split. Swap providerType to \"independent\" and companyId for independentProviderId to book a solo provider instead."
          },
          "response": []
        },
        {
          "name": "Create booking — as manager (for a known client)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"categoryCode\": \"klempner\",\n  \"serviceLabel\": \"Rohrverstopfung\",\n  \"providerType\": \"company\",\n  \"clientEmail\": \"familie.weber@example.com\",\n  \"clientPhone\": \"+49 201 5551234\",\n  \"addressStreet\": \"Girardetstraße 12\",\n  \"addressPostalCode\": \"45131\",\n  \"addressCity\": \"Essen\",\n  \"scheduledDate\": \"2026-09-12\",\n  \"scheduledTime\": \"09:00\",\n  \"priceGross\": 68.00,\n  \"assignedWorkerId\": \"{{workerId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] },
            "description": "company_manager only. clientEmail must belong to an existing client account (see docs/ARCHITECTURE.md) — familie.weber@example.com is seeded. Omit assignedWorkerId to leave it unassigned (\"assign later\")."
          },
          "response": []
        },
        {
          "name": "Get booking by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}"] }
          },
          "response": []
        },
        {
          "name": "Assign a worker",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
