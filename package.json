{
  "name": "homeservice-backend",
  "version": "1.0.0",
  "description": "Shared REST API for the HomeServices platform — serves both the client app (home-services-app) and the provider app (home-services-company-app: companies, workers, independents).",
  "private": true,
  "license": "UNLICENSED",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "node db/scripts/createDatabase.js",
    "db:schema": "node db/scripts/runSqlFile.js db/schema.sql",
    "db:seed": "node db/scripts/runSqlFile.js db/seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed",
    "tunnel": "ngrok http 4000",
    "lint": "eslint src --ext .js",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3",
    "sequelize": "^6.37.3",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
