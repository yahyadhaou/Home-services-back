# ─────────────────────────────────────────────────────────────────────────
# HomeService Backend — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets. In production, inject these via your platform's
# secret manager (not a committed file at all).
# ─────────────────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call this API (the two Expo
# apps' dev/web origins + your production app domains). No wildcard in prod.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=homeservice
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
# Separate, higher-privilege user for running migrations/schema changes —
# the runtime app user (above) should NOT have DDL rights in production.
DB_MIGRATE_USER=homeservice_migrator
DB_MIGRATE_PASSWORD=replace-with-your-migration-user-password

# --- Auth ---
# Generate strong random secrets, e.g.: `openssl rand -base64 64`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Field-level encryption (IBAN, BIC at rest) ---
# 32-byte key, base64-encoded, e.g.: `openssl rand -base64 32`
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Logging ---
LOG_LEVEL=info
